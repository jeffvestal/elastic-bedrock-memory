# Elastic Cloud - your deployment
ELASTICSEARCH_URL=https://YOUR-DEPLOYMENT-ID.es.us-east-1.aws.elastic.cloud
KIBANA_URL=https://YOUR-DEPLOYMENT-ID.kb.us-east-1.aws.elastic.cloud
ELASTICSEARCH_API_KEY=your-es-api-key-here
KIBANA_API_KEY=your-kibana-api-key-here

# Kibana basic auth (required for Workflows + Agent Builder REST API)
KIBANA_USER=elastic
KIBANA_PASSWORD=your-kibana-password-here

# Set by validate-write-path.py after creating the save-knowledge-fact workflow
WORKFLOW_ID=

# AWS Bedrock (optional - for blog code examples, not required for demo)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret
